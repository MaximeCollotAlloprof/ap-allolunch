# Config pour lancer AlloLunch en local contre l'emulateur Firestore (npm run emulator),
# sans toucher a un vrai projet GCP. Copier vers .env pour le dev local.

PORT=8080

# "demo-*" est le prefixe reconnu par l'emulateur Firestore: aucun vrai projet GCP requis.
FIRESTORE_PROJECT_ID=demo-allolunch
FIRESTORE_EMULATOR_HOST=localhost:8081

# URL publique exacte de l'endpoint webhook telle que configuree dans la console Google
# Chat API (Configuration > Connection settings > HTTP endpoint URL) - c'est l'audience
# attendue dans le token signe par Google. Pour tester en conditions reelles via `npm run
# tunnel` (ngrok), mettre a jour avec l'URL ngrok + /chat/webhook a chaque redemarrage du
# tunnel (l'URL change a chaque fois en plan gratuit). Une valeur factice suffit si vous
# ne testez pas de vrais appels Google Chat (la verification du token echouera alors).
CHAT_WEBHOOK_URL=https://example.ngrok-free.dev/chat/webhook

# Valeur factice en local (obligatoire pour passer la validation de config au demarrage,
# utilisee pour preparer l'integration Calendar - lot 3).
CALENDAR_DELEGATED_SERVICE_ACCOUNT_EMAIL=local-dev@example.com

MATCH_HISTORY_WINDOW_CYCLES=4

# Cle API Gemini (https://aistudio.google.com/apikey) - obligatoire meme en local pour
# tester /scheduler/weekly-reset (genere les questions hebdomadaires de /interets).
GEMINI_API_KEY=
