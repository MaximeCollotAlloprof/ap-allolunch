# Config pour lancer AlloLunch en local contre l'emulateur Firestore (npm run emulator),
# sans toucher a un vrai projet GCP. Copier vers .env pour le dev local.

PORT=8080

# "demo-*" est le prefixe reconnu par l'emulateur Firestore: aucun vrai projet GCP requis.
FIRESTORE_PROJECT_ID=demo-allolunch
FIRESTORE_EMULATOR_HOST=localhost:8081

# Valeurs factices en local: non utilisees tant que les lots 1 (verif. webhook Chat) et 3
# (delegation domain-wide Calendar) ne sont pas implementes.
GOOGLE_CHAT_PROJECT_NUMBER=000000000000
CALENDAR_DELEGATED_SERVICE_ACCOUNT_EMAIL=local-dev@example.com

MATCH_HISTORY_WINDOW_CYCLES=4
