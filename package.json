{
  "name": "ap-allolunch",
  "version": "0.1.0",
  "private": true,
  "description": "AlloLunch - matching aleatoire d'employes pour diner et briser les silos, via un bot Google Chat.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "emulator": "firebase emulators:start --only firestore --project demo-allolunch",
    "seed:local": "tsx scripts/seed-local.ts",
    "tunnel": "ngrok http 8080"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "google-auth-library": "^11.0.2",
    "googleapis": "^144.0.0",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.17.0",
    "firebase-tools": "^15.16.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
