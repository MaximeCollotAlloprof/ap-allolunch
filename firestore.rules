rules_version = '2';

// AlloLunch n'expose aucune donnee Firestore a un client (mobile/web). Toutes les
// lectures/ecritures passent exclusivement par le SDK Admin cote serveur (service
// Cloud Run), authentifie via les Application Default Credentials du service account -
// ces acces contournent completement ces regles et ne sont donc pas affectes par elles.
//
// Ce fichier bloque donc tout acces via les SDK clients Firestore (web/mobile), qui ne
// devraient de toute facon jamais etre utilises par ce projet. Voir docs/firestore-schema.md
// pour le detail des collections (employees, matchCycles, matchGroups).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
