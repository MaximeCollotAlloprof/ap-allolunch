rules_version = '2';

// Regles permissives pour l'emulateur local uniquement. Les vraies regles de
// production (acces restreint au service Cloud Run via IAM, pas de client-side
// access) sont a definir dans le lot 2 - voir docs/tickets.md.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
