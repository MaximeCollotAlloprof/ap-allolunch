# Port HTTP local (Cloud Run fournit automatiquement PORT en production)
PORT=8080

# Projet GCP contenant la base Firestore
FIRESTORE_PROJECT_ID=allolunch-dev

# Numero de projet configure dans la Google Chat API (console.cloud.google.com > Google Chat API)
GOOGLE_CHAT_PROJECT_NUMBER=

# Compte de service utilise pour la delegation domain-wide (creation d'evenements Calendar)
CALENDAR_DELEGATED_SERVICE_ACCOUNT_EMAIL=

# Nombre de cycles precedents a considerer pour eviter de rematcher les memes personnes
MATCH_HISTORY_WINDOW_CYCLES=4
